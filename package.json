{
  "name": "ff-for-github",
  "version": "0.1.1",
  "private": true,
  "description": "Shows whether a GitHub pull request or comparison can be fast-forward merged.",
  "type": "module",
  "scripts": {
    "ci": "tsc --noEmit && oxlint && oxfmt --check",
    "fix": "oxlint --fix",
    "fmt": "oxfmt",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "solid-js": "^1.9.13",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-solid": "^1.1.4",
    "chrome-types": "^0.1.429",
    "eslint-plugin-solid": "^0.14.5",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@11.8.0"
}
